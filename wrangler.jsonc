{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ajvillalobos",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "ajvillalobos.com", "custom_domain": true },
    { "pattern": "www.ajvillalobos.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
